{
    "$schema": "https://opencode.ai/config.json",
    "formatter": false,
    "graphicsMode": "kitty",
    "pixelRatio": 3,
    "default_agent": "dumbass",
    "model": "opencode-go/omen-alpha",
    "small_model": "opencode-go/muse-spark-1.3-contributor",
    "agent": {
        "explore": {
            "model": "opencode-go/muse-spark-1.3-contributor"
        },
    },
    "mode": {
        "dumbass": {
            "permission": {
                "edit": "ask",
                "write": "ask",
                "bash": {
                    "cd *": "allow",
                    "rg *": "allow",
                    "ls *": "allow",
                    "grep *": "allow",
                    "head *": "allow",
                    "find *": "allow",
                    "*": "ask",
                    "git *": "ask",
                    "git status *": "ask",
                    "git commit *": "deny",
                    "git push *": "deny"
                },
                "webfetch": "ask",
                "doom_loop": "ask",
                "external_directory": {
                    "/tmp/**": "allow",
                    "*": "ask"
                }
            }
        },
    },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    }
  },
    "lsp": {
        "kotlin-ls": {
            "disabled": true
        },
    "rust": {
      "command": [
        "/usr/bin/lspmux"
      ]
    }
    },
    "mcp": {
    },
    "plugin": [
    ],
}
